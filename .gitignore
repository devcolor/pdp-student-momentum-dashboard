.DS_Store
__pycache__/
*.pyc
.venv/
venv/
.env
node_modules/
# Real PDP exports hold FERPA-protected student records: keep them here, never commit them
data/private/
.ipynb_checkpoints/

# Compound Engineering local scratch and per-person config
.context/compound-engineering/
.compound-engineering/

# Matt Pocock's skills local scratch
.scratch/

# Foundation tests
.pytest_cache/

# Data model validation runs: local audit records, not committed
normalized-data-model/logs/*
!normalized-data-model/logs/.gitkeep

# Data model staging area: each run's mapped, fixed and validated tables, local records, not committed
normalized-data-model/data/staging/

# Data model loader: the SQLite database it writes (default output/pdp.sqlite), not committed
normalized-data-model/output/

# Files uploaded through the Playground's pipeline page, and the build record of the editable install
normalized-data-model/data/uploads/
*.egg-info/
*.sqlite
*.sqlite3
.vscode/mcp.json

# Success measures: the saved results database, not committed
measures/output/

# Equity gap finder: the CSVs it writes, not committed
gap_finder/output/

# Vercel deploy: the databases playground/deploy/build_data.sh builds, and the CLI's project link
playground/server_application/deploy_data/
.vercel/
# The token file `vercel link` writes at the repo root
/.env.local
# Local env files anywhere, including the keys `vercel env pull` writes. Never the committed
# .env.development, .env.production and .env.staging, which do not end in .local
.env*.local
# Copies playground/deploy/shared_code.sh puts in the API's folder during a deploy
playground/server_application/normalized-data-model/
playground/server_application/_vendor/
playground/server_application/mcp/
playground/server_application/gap_finder/
playground/server_application/measures/
# What a local `vercel build` leaves behind
playground/server_application/_uv/
normalized-data-model/build/
