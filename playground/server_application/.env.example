# Every setting the server application reads, with a placeholder value. This file isn't loaded.
# Copy the lines you need into .env.development.local (git-ignored), next to this file.
#
# app/core/config.py loads, in increasing priority:
#   .env.<APP_ENV>          committed, non-secret defaults (.env.development, .env.staging, .env.production)
#   .env.<APP_ENV>.local    git-ignored, your secrets and overrides
#   real environment vars   what a hosting platform injects
# Never put a real key in a committed file.

# --- Environment ------------------------------------------------------------------------

# Optional. development | staging | production. Picks which .env.<APP_ENV> files load, so set it
# in the real environment (your shell or the service), not in an env file: it's read first.
# production turns off Swagger UI and, through .env.production, the Sandbox. Default: development.
APP_ENV=development

# Optional. Name, version and URL prefix the API reports. Defaults: Playground API, 0.1.0, /api/v1.
# PROJECT_NAME=Playground API
# VERSION=0.1.0
# API_V1_PREFIX=/api/v1

# --- Database ---------------------------------------------------------------------------

# Required. Where the API keeps its tables and the loaded data model.
# `mise run db:choose sqlite` writes the SQLite one to .env.development.local for you.
DATABASE_URL=sqlite:///./playground_dev.db
# PostgreSQL instead (needs Docker: `mise run db:choose postgresql`, then `mise run db`):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/playground_dev

# Optional. Log every SQL statement. Default: false.
# DATABASE_ECHO=false
# Optional. PostgreSQL connection pool size and overflow. Ignored by SQLite. Defaults: 5 and 10.
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10

# --- Web ------------------------------------------------------------------------------------

# Optional. Browser origins allowed to call the API, as a JSON list. Default: none.
# .env.development already allows the local client.
CORS_ORIGINS=["http://localhost:3000"]

# --- Sandbox, Workbench and chat -------------------------------------------------------

# Optional. Serves the Sandbox and Workbench endpoints (pipeline, uploads, dictionary, every view).
# Default: true. .env.production sets false.
# SANDBOX_ENABLED=true

# Optional. Largest file, in bytes, that the Workbench upload accepts. Default: 104857600 (100 MB).
# PIPELINE_UPLOAD_MAX_BYTES=104857600

# Optional. Turns the AI chat on. Get a key at https://console.anthropic.com (API keys).
# Without it the chat panel says the chat is off, and every other page works.
# Put the real key in .env.development.local only.
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional. The Anthropic model the chat calls. Default: claude-sonnet-5-5.
# SANDBOX_CHAT_MODEL=claude-sonnet-5-5

# Optional. Set false to turn the chat off even when a key is set (it calls a paid model).
# Default: true.
# SANDBOX_CHAT_ENABLED=true

# --- Published results ------------------------------------------------------------------

# Optional. The published measures file that the results-based views read (de-aggregation, course
# outcomes, executive view gaps). Default: measures/output/success_measures.sqlite, written by
# `python -m measures.publish` from the repo root. Relative paths are from server_application/.
# RESULTS_DB=../../measures/output/success_measures.sqlite
# Optional. Read when RESULTS_DB isn't set. The Vercel example deploy sets it to its trimmed copy.
# DEAGGREGATION_DB=deploy_data/success_measures.sqlite

# --- Read by mise tasks and tests, not by the app -----------------------------------------

# Optional. `mise run api:dev` applies migrations first unless this is false. Default: true.
# Set it in your shell or in playground/mise.local.toml, not here.
# AUTO_MIGRATE=true
# Optional. `mise run api:test-sqlite` sets it to run the tests on SQLite. Default: unset.
# TEST_ON_SQLITE=true
